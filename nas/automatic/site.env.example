# Copy to site.env (gitignored) and fill in. deploy.sh turns it into the service's .env
# on the NAS and adds the generated secrets (GATE_USER, GATE_PASS, API_TOKEN).

# The seedbox's qBittorrent WebUI, as the NAS reaches it.
QB_URL=https://seedbox.example.com:8080
QB_CATEGORY=tv-sonarr
# Stop starting new downloads when the seedbox has less free space than this.
MIN_FREE_GB=100

# Host paths on the NAS.
AUTOMATIC_DATA=/srv/magnet-automatic
SONARR_CONFIG_FILE=/srv/docker/sonarr/config.xml
# Optional: lets the list of sites in Magnet decide where Sonarr searches.
PROWLARR_CONFIG_FILE=/srv/docker/prowlarr/config.xml
# Optional: suggestions from what is being watched in Plex.
PLEX_PREFERENCES_FILE=/srv/docker/plex/Library/Application Support/Plex Media Server/Preferences.xml

# How the container reaches the other services. Ports published on the host answer on
# the Docker bridge gateway.
SONARR_URL=http://172.17.0.1:8989
PROWLARR_URL=http://172.17.0.1:9696
PLEX_URL=http://172.17.0.1:32400

# qBittorrent's save-path prefix = the same files where Sonarr sees them (a mount of the seedbox).
PATH_MAP=/downloads/=/seedbox/downloads/

# Only if Prowlarr has more than one Sonarr application: the name of the one behind the gate.
PROWLARR_SONARR_APP=
# The port Magnet reaches the API on (the service itself always listens on 8790 inside).
API_HOST_PORT=8790

# The user the container runs as: one that can read the config files above and, with
# SEASON_FOLDERS on, create folders and move files in the TV library -- normally the
# PUID/PGID Sonarr itself runs as.
PUID=1000
PGID=1000

# The scout: how long to keep looking for a better copy after the first one, how often
# once the first two days are over (before that it is every 20 minutes for six hours,
# then hourly), when a download counts as stalled, and whether a finished better copy
# retires the worse one from the seedbox.
SCOUT_WINDOW_DAYS=7
SCOUT_UPGRADE_EVERY_HOURS=6
SCOUT_STALL_HOURS=3
SCOUT_REMOVE_SUPERSEDED=true
# A first copy that would take longer than this to finish is swapped for the next best.
SCOUT_FIRST_COPY_MAX_HOURS=4

# Copy each finished episode to its show folder on the NAS by itself. false leaves it on
# the seedbox until Bring to NAS is pressed.
AUTO_COPY=true
# Once an episode is on the NAS, remove its torrent and files from the seedbox.
REMOVE_AFTER_COPY=true

# Season folders: each new episode goes into the folder Plex files that season under
# (or a new "Season N" named like the show's others), and a badly named season folder
# is renamed to "Season N" on the way. deploy.sh mounts every TV folder that Sonarr and
# Plex both see -- read from the two containers' mounts -- so name the containers here.
SEASON_FOLDERS=true
SONARR_CONTAINER=sonarr
PLEX_CONTAINER=plex
# Show folders whose seasons are never touched: the folder's own name (not its path),
# separated by "|".
SEASON_SKIP=
