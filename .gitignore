macapp/blocklist-*.json
macapp/blocklists-manifest.json
tools/.cache/

# Machine-specific configuration and secrets
local.env
tools/seed-local.sh
# Reverses this machine's deployment, NAS side included
rollback.sh

# Working snapshots taken before risky edits
backup/

.DS_Store
